DATABASE_URL="postgresql://postgres:123@localhost:5432/document_db"
# ========================
# Document Service Environment
# ========================

# Server
PORT=3003
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123
DB_NAME=document_db

# JWT
JWT_ACCESS_SECRET=JUSTASECRET
JWT_REFRESH_SECRET=JUSTASECRET
JWT_ACCESS_EXPIRES_IN=3d    
JWT_REFRESH_EXPIRES_IN=7d

BASE_URL=http://localhost:3000

ENABLE_RABBITMQ=false

# Gemini API (phân tích 1 lần sau upload) — tạo key mới: https://aistudio.google.com/apikey
# Nếu key bị báo "leaked", Google sẽ từ chối mọi model → chỉ còn chế độ local.
GEMINI_API_KEY=AIzaSyCWUuB1AnkCvzfOriuKLkFTE6d12yEppFo
# Model đang test (chạy: npm run test:gemini)
GEMINI_MODEL=gemini-2.5-flash-lite
