# ========================
# Dashboard Service Environment
# ========================

# Server
PORT=3002
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123
DB_NAME=dashboard_db
DATABASE_URL="postgresql://postgres:123@localhost:5432/dashboard_db"

# JWT
JWT_ACCESS_SECRET=JUSTASECRET

# RabbitMQ
ENABLE_RABBITMQ=false

